# Copy this file to .env, then fill in your API settings.
# Supports OpenAI and most OpenAI-compatible API services.

OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Choose a model that supports image input.
MASCOT_MODEL=gpt-4o-mini

# low is faster, high is clearer.
MASCOT_SCREEN_DETAIL=low

# Attach the current screen when you manually chat.
INCLUDE_SCREEN_BY_DEFAULT=true

# Speak replies with AI TTS.
TTS_ENABLED=true
TTS_PROVIDER=minimax
TTS_API_KEY=
TTS_BASE_URL=https://api.minimax.io/v1
TTS_MODEL=speech-2.8-turbo
TTS_VOICE_ZH=Chinese (Mandarin)_Crisp_Girl
TTS_VOICE_JA=Japanese_GracefulMaiden
TTS_RESPONSE_FORMAT=mp3
TTS_SAMPLE_RATE=32000
TTS_BITRATE=128000
TTS_SPEED=1.0
TTS_VOLUME=1.0
TTS_PITCH=0

# Output language for mascot replies and TTS: zh or ja.
MASCOT_LANGUAGE=zh

# Automatically screenshot and let the mascot comment.
AUTO_OBSERVE_ENABLED=true
AUTO_OBSERVE_INTERVAL_SECONDS=60

# Keep recent context turns.
MASCOT_MAX_HISTORY_TURNS=8
MASCOT_REQUEST_TIMEOUT=60

# Optional custom personality prompt.
# MASCOT_SYSTEM_PROMPT=Short Chinese desktop mascot. One sentence only. No Markdown.
